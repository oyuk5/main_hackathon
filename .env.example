# Copy to .env for local dev. Give Patterno the real values at hand-in.
OPENAI_API_KEY=
# Model names. We use MODEL_SMART=gpt-6.2-sol and MODEL_FAST=gpt-6-luna.
MODEL_SMART=
MODEL_FAST=
# USD per million tokens, from the provider's price page (feeds the cost ledger).
PRICE_SMART_IN=2
PRICE_SMART_OUT=10
PRICE_FAST_IN=0.10
PRICE_FAST_OUT=0.50
# Cached input in USD per million tokens; omit to use half the input price.
# PRICE_SMART_CACHED_IN=
# PRICE_FAST_CACHED_IN=
# Disable prompt caching:
# LLM_PROMPT_CACHE=0
# Model budgets (USD, per portal lifetime and per server-local day):
# MAX_MODEL_USD_PER_PORTAL=3.00
# MAX_MODEL_USD_PER_DAY=20
# Optional
PORT=8080
DATA_DIR=./data
READ_INTERVAL_MINUTES=30
FAILED_RETRY_MINUTES=30
# Optional, with their defaults. Uncomment to change.
# Docker's --env-file keeps anything after "=" literally, so comments go on their own line.
# An OpenAI-compatible provider instead of OpenAI:
# OPENAI_BASE_URL=
# Gap between two requests to one portal, never below 1000:
# MIN_REQUEST_GAP_MS=1100
# Largest document kept (250 MB):
# MAX_FILE_BYTES=262144000
# Document downloads per read at most; the rest follow in the next reads:
# DOC_REFS_PER_READ=300
# FIRST_DOC_REFS=60
# How long a browser download waits for a page, a click target or the file:
# BROWSER_STEP_MS=20000
# USER_AGENT=WatchtowerBot/0.1 (+tender monitoring; polite, 1 req/s)
# TZ_DISPLAY=Europe/Berlin
# LOG_LEVEL=warn
# Fill an empty database with sample portals for a showcase (Dockerfile.vercel). Leave unset for evaluation.
# SEED_DEMO=1
