# Copy to .env for local dev. Give Patterno the real values at hand-in.
OPENAI_API_KEY=
# Model names: pick from the provider's model list at the event.
MODEL_SMART=
MODEL_FAST=
# USD per million tokens, from the provider's price page (feeds the cost ledger).
PRICE_SMART_IN=0
PRICE_SMART_OUT=0
PRICE_FAST_IN=0
PRICE_FAST_OUT=0
# Optional
PORT=8080
DATA_DIR=./data
READ_INTERVAL_MINUTES=30
FAILED_RETRY_MINUTES=30
