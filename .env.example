# Copy to .env for local dev. Give Patterno the real values at hand-in.
OPENAI_API_KEY=
# Model names. We use MODEL_SMART=gpt-6.2-sol and MODEL_FAST=gpt-6-luna.
MODEL_SMART=
MODEL_FAST=
# USD per million tokens, from the provider's price page (feeds the cost ledger).
PRICE_SMART_IN=0
PRICE_SMART_OUT=0
PRICE_FAST_IN=0
PRICE_FAST_OUT=0
# Optional
PORT=8080
DATA_DIR=./data
READ_INTERVAL_MINUTES=30
FAILED_RETRY_MINUTES=30
# Optional, with their defaults. Uncomment to change.
# OPENAI_BASE_URL=            # an OpenAI-compatible provider instead of OpenAI
# MIN_REQUEST_GAP_MS=1100     # never below 1000
# MAX_FILE_BYTES=262144000    # 250 MB
# USER_AGENT=WatchtowerBot/0.1 (+tender monitoring; polite, 1 req/s)
# TZ_DISPLAY=Europe/Berlin
# LOG_LEVEL=warn
