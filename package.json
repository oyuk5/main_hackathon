{
  "name": "watchtower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:contract": "tsx scripts/contract-check.ts",
    "lab": "tsx lab/serve.ts",
    "eval": "tsx lab/eval.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "5.61.12",
    "@clerk/fastify": "3.1.106",
    "@fastify/static": "10.1.12",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "cheerio": "1.2.0",
    "d3-geo": "3.1.2",
    "fastify": "5.12.8",
    "jsonpath-plus": "11.3.0",
    "openai": "7.62.0",
    "playwright": "1.65.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/d3-geo": "3.1.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
