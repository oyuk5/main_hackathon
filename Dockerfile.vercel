# Vercel Container Function: serves Watchtower API + dashboard on port 80 (or $PORT).
# Root Dockerfile (port 8080) remains untouched for hackathon submission.
FROM mcr.microsoft.com/playwright:v1.65.1-noble AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build && npm prune --omit=dev

FROM mcr.microsoft.com/playwright:v1.65.1-noble
WORKDIR /app
ENV NODE_ENV=production PORT=80 DATA_DIR=/tmp/watchtower-data
RUN node -e "require('node:sqlite')"
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./
EXPOSE 80
CMD ["node", "--disable-warning=ExperimentalWarning", "dist/server.mjs"]
